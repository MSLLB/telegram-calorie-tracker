        "jsCode": "const s = $('Summarize').first().json;\nconst pas = Number($input.first().json.pas) || 0;\n\nconst calories = Number(s.sum_calories) || 0;\nconst proteines = Number(s['sum_protéines']) || 0;\nconst glucides = Number(s.sum_glucides) || 0;\nconst lipides = Number(s.sum_lipides) || 0;\nconst repas = Number(s.count_repas) || 0;\n\nconst bonus = Math.floor(pas / 5000) * 100;\nconst objectif = 2000 + bonus;\nconst ecart = objectif - calories;\n\nreturn [{\n  json: {\n    pas, calories, proteines, glucides, lipides, repas,\n    bonus, objectif,\n    restant: Math.max(ecart, 0),\n    depasse: Math.max(-ecart, 0)\n  }\n}];"
